# Hosted PostgreSQL Database URL (e.g. Neon, Supabase, Vercel Postgres, AWS RDS)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AI / LLM API Key Configuration (Supports OpenAI, Anthropic, or Google Gemini)
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"
LLM_MODEL="gpt-4o"

# Application Settings
NEXT_PUBLIC_APP_NAME="Contract & Compliance Intelligence AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
